{
  "model": "meta-llama/Llama-3.2-1B-Instruct",
  "driver": "replay.py via OpenAI-compatible endpoint",
  "endpoint": "http://127.0.0.1:8000",
  "dataset_path": "workloads/random-llama-3.2-1b-48-sps1.jsonl",
  "num_requests": 48,
  "engine_kwargs": {
    "model": "meta-llama/Llama-3.2-1B-Instruct",
    "dtype": "bfloat16",
    "kv_cache_dtype": "auto",
    "max_num_seqs": 4,
    "max_num_batched_tokens": 512,
    "max_model_len": 4096,
    "block_size": 1024,
    "num_gpu_blocks_override": 64,
    "enable_prefix_caching": true
  },
  "kv_transfer": {
    "connector": "RblnNixlConnector",
