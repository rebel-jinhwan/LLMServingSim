    "prefill": {
      "device": "RBLN-CR03 #0",
      "kv_role": "kv_producer"
    },
    "decode": {
      "device": "RBLN-CR03 #1",
      "kv_role": "kv_consumer"
    },
    "proxy": "vLLM tests/v1/kv_connector/nixl_integration/toy_proxy_server.py"
  },
  "hardware": {
    "device_name": "RBLN-CR03",
    "rebel_version": "0.11.3.dev237+g687d3f76"
  },
  "vllm_version": "0.26.0"
}